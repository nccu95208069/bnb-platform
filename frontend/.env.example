NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase (admin panel auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SEO & Analytics
NEXT_PUBLIC_SITE_URL=https://beyondnbeyond.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Sheet monitor: server-only; disabled until storage, reader and scheduler are verified.
SHEET_MONITOR_ENABLED=false
# Only source keys with verified schema and room mapping may be activated.
BOOKING_SHEET_SOURCES=sweetfun
SHEET_MONITOR_GOOGLE_CREDENTIALS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Sean OS finance SSOT: server-only, independently enabled per property after
# its source reconciliation, connector cutover and deployment acceptance pass.
# Enabled properties never fall back to the old Redis money writer on failure.
# Requires CALENDAR_SOURCE=sheet_snapshot and the selected property in
# BOOKING_SHEET_SOURCES. Finance grants must have the same workspace/property as
# that property's authority calendar grant; use its separately issued finance credential.
# Grant JSON: {credentialId,clientId,workspaceId,propertyId,token}; no live values
# belong in this file. Store grants and proof secrets as deployment Secrets.
OS_SWEETFUN_FINANCE_SSOT_ENABLED=false
IRON_GATE_SWEETFUN_SSOT_FINANCE_GRANT=
OS_OFFLAND_FINANCE_SSOT_ENABLED=false
# Old cash is not imported by enabling the new writer. Set verified only after separate reconciliation.
OS_OFFLAND_FINANCE_HISTORY_STATUS=not_imported
# Emergency pause; keep SSOT enabled after cutover. Never reopen the legacy writer.
OS_OFFLAND_FINANCE_WRITES_PAUSED=false
# Match the initial backend grant: general income/expenses only.
OS_OFFLAND_FINANCE_GENERAL_ONLY=true
IRON_GATE_OFFLAND_SSOT_FINANCE_GRANT=

# Offland finance uses the already-authoritative Offland booking source.
# These are separate from Sweetfun calendar and finance grants. Preview-only
# calendar snapshots cannot authorize finance. The room map has one key: 包棟.
IRON_GATE_OFFLAND_CALENDAR_ENABLED=false
IRON_GATE_OFFLAND_CALENDAR_PREVIEW_ENABLED=false
IRON_GATE_OFFLAND_CALENDAR_GRANT=
IRON_GATE_OFFLAND_BASE_URL=
IRON_GATE_OFFLAND_AUTHORITY_EPOCH=
IRON_GATE_OFFLAND_ROOM_IDS=
# Optional dedicated OS proof secret; when omitted, the existing shared
# IRON_GATE_SWEETFUN_OS_PROOF_SECRET is used by the property-scoped grant.
# IRON_GATE_OFFLAND_OS_PROOF_SECRET=

# Public service intake: enable only after notification verification in deployment.
CUSTOMER_INTAKE_ENABLED=false
# Suppresses outbound intake mail; use only with a synthetic/local data store.
CUSTOMER_INTAKE_PREVIEW=false
# Native customer records and intake submissions share this isolated namespace.
CUSTOMER_WORKSPACE_NAMESPACE=bnb:customers:v1

# Standard ledger output: source Sheets stay read-only. Share only each
# independent destination copy as Editor with this service account.
# Falls back to CUSTOMER_SHEET_READER_CREDENTIALS when omitted.
CUSTOMER_STANDARD_SHEET_CREDENTIALS=
# Optional automatic copy factory; requires a writable shared-drive folder.
# Without these, owners can bind a prepared blank standard-workbook copy.
CUSTOMER_STANDARD_SHEET_TEMPLATE_ID=
CUSTOMER_STANDARD_SHEET_FOLDER_ID=

# Candidate email links; only server-controlled Vercel origins are accepted.
# Leave the origin commented out to use VERCEL_URL, not an empty assignment.
CUSTOMER_DEPLOYMENT_LINKS=false
# CUSTOMER_DEPLOYMENT_ORIGIN=https://<stable-protected-alias>.vercel.app

# Google identity and read-only Calendar OAuth; separate from Sheet grants.
# Register this callback on the actual customer origin:
# https://<customer-origin>/api/customer-calendar/callback
CUSTOMER_CALENDAR_CLIENT_ID=
CUSTOMER_CALENDAR_CLIENT_SECRET=
CUSTOMER_CALENDAR_REDIRECT_URI=
# Independently generated 32-byte base64 key for encrypted refresh credentials.
CUSTOMER_CALENDAR_TOKEN_KEY=
# Keep disabled until OAuth + the protected cron have passed deployment acceptance.
# Requires CRON_SECRET and durable customer storage; file imports do not need OAuth.
CUSTOMER_CALENDAR_SYNC_ENABLED=false
# Setup and live acceptance: docs/work-handoff/CALENDAR_GOOGLE_SETUP_2026-10-04.md

# Order health: optional dedicated 32+ character encryption secret.
# When omitted, uses CUSTOMER_SESSION_SECRET, then CALENDAR_OWNER_SESSION_SECRET.
# Changing the effective key makes existing encrypted reports unreadable.
ORDER_HEALTH_ENCRYPTION_KEY=
# Optional AI header recognition and grounded report Q&A. Set both to enable.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional dedicated Sheet reader for order health; falls back to CUSTOMER_SHEET_READER_CREDENTIALS.
# Only a spreadsheets.readonly OAuth scope is requested.
ORDER_HEALTH_SHEET_READER_CREDENTIALS=
# Only spreadsheets.readonly is requested; credentials never reach the browser.

# Optional exact HTTPS origins of already-registered Studio clients allowed to
# request new UUID sites. Owner verification/approval remains mandatory and new
# bindings start with sales disabled. Existing secret registries are unchanged.
WEBSITE_BOOKING_STUDIO_SELF_SERVICE_ORIGINS=[]

# Automatic email delivery only for owner-approved sites of explicitly enabled Studio clients.
WEBSITE_BOOKING_STUDIO_EMAIL_CLIENT_IDS=[]
# Optional ISO timestamp: newly approved bindings only; exact legacy scopes stay unchanged.
# WEBSITE_BOOKING_STUDIO_EMAIL_START_AT=2026-10-15T00:00:00.000Z

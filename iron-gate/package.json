{
  "name": "iron-gate-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:private": "node --experimental-strip-types src/main.mjs",
    "test": "npm run build && node --experimental-sqlite --experimental-strip-types --test tests/*.test.mjs",
    "test:pg": "node --experimental-strip-types --test tests/postgres-repository.test.mjs",
    "test:restore": "node --experimental-strip-types scripts/pg-restore-drill.mjs",
    "test:server": "node --experimental-strip-types --test tests/node-server.integration.mjs",
    "shadow:report": "node --experimental-strip-types src/os-shadow-cli.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node dist/main.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "pg": "8.20.0"
  }
}
